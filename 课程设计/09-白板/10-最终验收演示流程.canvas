{
	"nodes":[
		{"id":"10-title","type":"text","text":"最终验收演示流程\n固定 Demo：查询 → 可视化 → 切换条件 → 数据维护 → 重新查询","x":0,"y":-180,"width":980,"height":110,"color":"#64748b"},
